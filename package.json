{
  "name": "dsh-plugin-persona",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 人格管理器：多套人设 + 会话级切换 + 默认人格（Host 半 + Web 客户端半）",
  "keywords": ["dsh", "dsh-plugin", "deepseek", "harness", "persona", "人设", "人格"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YUAN-OVO66/dsh-plugin-persona.git"
  },
  "homepage": "https://github.com/YUAN-OVO66/dsh-plugin-persona#readme",
  "bugs": { "url": "https://github.com/YUAN-OVO66/dsh-plugin-persona/issues" },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "test", "cordis.patch.yml", "README.md"],
  "scripts": {
    "test": "node test/check-persona.js && node test/verify-host.js && node test/verify-client.js"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true }
  }
}
